# Example environment variables for WanderLust AI
# Copy this file to .env.local and fill in values.

# Gemini API key used by geminiService.ts
GEMINI_API_KEY=YOUR_KEY_HERE

# Tiempo (ms) para poder borrar un viaje recién creado.
# 60000 = 1 minuto, 300000 = 5 minutos, 0 o ausencia => usa fallback 60000.
VITE_DELETION_WINDOW_MS=60000
